{
  "name": "derzhava",
  "private": true,
  "version": "0.1.0",
  "description": "Держава — стратегия-песочница: управляйте реальной страной",
  "author": "Держава",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "map": "node scripts/build-map.mjs",
    "sim": "tsx scripts/sim-test.ts",
    "test": "node scripts/run-tests.mjs",
    "app": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win",
    "icon": "electron scripts/make-icon.cjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@fontsource/cormorant-sc": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@iconify-json/game-icons": "1.2.4",
    "@preact/preset-vite": "2.10.6",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "pixi.js": "8.22.0",
    "preact": "10.29.8",
    "topojson-client": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "world-atlas": "2.0.2"
  },
  "build": {
    "appId": "com.derzhava.game",
    "productName": "Держава",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Держава",
      "artifactName": "Derzhava-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Derzhava-${version}-portable.${ext}"
    }
  }
}
